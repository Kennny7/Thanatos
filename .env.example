# ===========================================================================
# Thanatos AI - Comprehensive Environment Configuration Template
# ===========================================================================
# Copy this file to `.env` in the project root and customize your local settings:
#   cp .env.example .env
#
# All variables are populated with safe defaults.
# Environment variables will override values set in `.env`.
# ===========================================================================

# ---- Application & Networking --------------------------------------------
APP_NAME=Thanatos AI
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false
WEBSOCKET_HEARTBEAT_INTERVAL=15

# ---- Local LLM & Ollama Core ---------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
LLM_BASE_URL_DOCKER=http://ollama:11434
LLM_ADAPTER_URL=http://localhost:8001/v1
LLM_ADAPTER_URL_DOCKER=http://local-llm:8001/v1
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0
LLM_ENABLE_THINKING=true

# ---- Cloud LLM Providers (Optional) --------------------------------------
# Set your API keys to enable cloud model execution:
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CHAT_MODEL=deepseek-chat
# OPENAI_API_KEY=your_openai_api_key_here

# ---- Distributed Mesh & Zero-Config Subnet Discovery ----------------------
MESH_DISCOVERY_PORT=47470
MESH_SHARED_SECRET=thanatos_mesh_shared_secret_2026
MESH_HEARTBEAT_INTERVAL=10
AUTO_PULL_SLM_MODELS=true
MAX_SLM_PARAMETER_SIZE=9B

# ---- Hybrid Memory & Vector Databases ------------------------------------
VECTOR_DB_BACKEND=milvus           # Options: 'milvus', 'chroma', 'auto'
MEMORY_PERSIST_DIR=./memory_store
MEMORY_COLLECTION=thanatos_memories
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ---- Enterprise Multi-Engine Database Stack (Docker) ---------------------
# PostgreSQL 16 (Relational tables, operational logs, jobs, profile facts)
POSTGRES_USER=thanatos
POSTGRES_PASSWORD=thanatos_password
POSTGRES_DB=thanatos_memory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB 7.0 (Transcripts, dynamic raw dossiers, unformatted memories)
MONGO_INITDB_ROOT_USERNAME=thanatos_admin
MONGO_INITDB_ROOT_PASSWORD=thanatos_mongo_secret
MONGO_HOST=localhost
MONGO_PORT=27017

# Milvus 2.4.13 Standalone (Distributed high-scale vector engine)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Neo4j 5.20 Community (Knowledge graph, social relations & character arcs)
NEO4J_AUTH=neo4j/thanatos_graph_secret
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# ---- User Profile & Continuous Knowledge Directory -----------------------
USER_NAME=Khushal
USER_EMAIL=khushalpareta9@gmail.com
USER_LOCATION=Mumbai-India
USER_TITLE=ML-AI-Engineer
PROFILE_DIR=./data/profile_dir

# ---- Email / SMTP Dispatch Configuration (Optional) ---------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=your_email@gmail.com

# ---- Speech Intelligence & Acoustic Voice Pipeline ----------------------
TTS_VOICE=en-US-AriaNeural
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
SPEAKER_ENROLLMENT_DIR=./voice_profiles

# ---- Logging & Diagnostics -----------------------------------------------
LOG_DIR=logs
LOG_CONFIG_PATH=config/logging.conf
