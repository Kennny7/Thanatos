# ===========================================================================
# Thanatos AI - Environment Configuration
# ===========================================================================
# Copy this file to `.env` and edit the values below.
# All variables are optional; defaults are shown as comments.
# Environment variables override .env values.
# ===========================================================================

# ---- Application ---------------------------------------------------------
# APP_NAME=Thanatos AI
# ENVIRONMENT=development
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false
# WEBSOCKET_HEARTBEAT_INTERVAL=15

# ---- LLM - Local (Ollama) ------------------------------------------------
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434
# LLM_BASE_URL_DOCKER=http://ollama:11434
# LLM_ADAPTER_URL=http://localhost:8001/v1
# LLM_ADAPTER_URL_DOCKER=http://local-llm:8001/v1
# LLM_TEMPERATURE=0.1
# LLM_MAX_RETRIES=3
# LLM_RETRY_DELAY=1.0

# ---- LLM - Cloud (DeepSeek / OpenAI) -------------------------------------
# Uncomment and set your API key to use a cloud LLM provider.
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CHAT_MODEL=deepseek-chat
# OPENAI_API_KEY=

# ---- Memory / ChromaDB ---------------------------------------------------
# MEMORY_PERSIST_DIR=./memory_store
# MEMORY_COLLECTION=thanatos_memories
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu

# ---- User Profile Defaults -----------------------------------------------
# These are fallback values used when no profile data exists yet.
# USER_NAME=User
# USER_EMAIL=user@example.com
# USER_LOCATION=
# USER_TITLE=

# ---- Voice / Speech ------------------------------------------------------
# TTS_VOICE=en-US-AriaNeural
# STT_MODEL=base
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8
# SPEAKER_ENROLLMENT_DIR=./voice_profiles

# ---- Logging --------------------------------------------------------------
# LOG_DIR=logs
# LOG_CONFIG_PATH=config/logging.conf
